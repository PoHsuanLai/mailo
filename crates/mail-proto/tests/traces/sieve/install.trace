# SYNTHETIC. Written from RFC 5804 (ManageSieve), with capability lines in the shape a
# Pigeonhole server sends them. Not a recording.
# Install: another script exists but is not active, so nothing stands in the way.
# The script goes up as a non-synchronizing literal and is then made active.
# The literal's bytes are install.script, beside this file.
S: "IMPLEMENTATION" "Example Sieve"
S: "SASL" ""
S: "SIEVE" "fileinto vacation imap4flags date relational"
S: "STARTTLS"
S: "VERSION" "1.0"
S: OK "ready"
C: STARTTLS
S: OK "begin TLS negotiation now"
TLS
# The capabilities again, now inside TLS: these are the ones that count.
S: "IMPLEMENTATION" "Example Sieve"
S: "SASL" "PLAIN LOGIN"
S: "SIEVE" "fileinto vacation imap4flags date relational"
S: "VERSION" "1.0"
S: OK "TLS negotiation successful"
C: AUTHENTICATE "PLAIN" "AG1lQGV4YW1wbGUudGVzdABzM2NyZXQ="
S: OK "Logged in."
C: LISTSCRIPTS
S: "old-filters"
S: OK "Listscripts completed."
C64: UFVUU0NSSVBUICJtYWlsbyIgezkyK30NCnJlcXVpcmUgWyJmaWxlaW50byJdOw0KaWYgaGVhZGVyIDpjb250YWlucyAic3ViamVjdCIgImludm9pY2UiIHsNCiAgICBmaWxlaW50byAiQmlsbHMiOw0KfQ0KDQo=
S: OK "Putscript completed."
C: SETACTIVE "mailo"
S: OK "Setactive completed."
C: LOGOUT
S: OK "Logout completed."
DONE
